---
import '../styles/global.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site, services } from '../data/site';

interface Props { title: string; description?: string; image?: string; path?: string; jsonLd?: object[] }
const { title, description = site.description, image = '/media/og.jpg', path = '', jsonLd = [] } = Astro.props;
const fullTitle = title === site.name ? `${site.name} | Película automotiva, PPF e acessórios em Cuiabá` : `${title} | ${site.name}`;
const canonical = `${site.url}/${path}`;
const ogImage = `${site.url}${image}`;
const a = site.address;
const business = {
  '@context': 'https://schema.org',
  '@type': 'AutoPartsStore',
  name: site.legalName,
  alternateName: site.name,
  url: site.url,
  image: ogImage,
  logo: `${site.url}/media/logo-512.png`,
  telephone: site.phoneE164,
  priceRange: '$$',
  address: { '@type': 'PostalAddress', streetAddress: a.street, addressLocality: a.city, addressRegion: a.state, postalCode: a.zip, addressCountry: 'BR' },
  areaServed: ['Cuiabá', 'Várzea Grande', 'Região de Cuiabá'],
  brand: { '@type': 'Brand', name: site.brand },
  openingHoursSpecification: site.hours.filter((h) => h.schema.length).map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.schema, opens: h.opens, closes: h.closes })),
  sameAs: [site.instagram],
  makesOffer: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title, description: s.short } })),
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0d10" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/barlow-condensed-800.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/open-sans.woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify([business, ...jsonLd])} />
    <script is:inline>
      // opening intro (logo sweep in Stage): once per session, motion allowed, page at the top. Decided before first paint.
      (function () {
        var h = document.documentElement, run = false;
        try { run = !sessionStorage.getItem('intro') && matchMedia('(prefers-reduced-motion: no-preference)').matches; sessionStorage.setItem('intro', '1'); } catch (e) {}
        h.classList.add(run ? 'intro' : 'intro-seen');
        addEventListener('DOMContentLoaded', function () {
          if (!run) return;
          if (scrollY > 0) return h.classList.replace('intro', 'intro-seen');
          var img = document.querySelector('.logo-intro__w img'), go = function () { h.classList.add('intro-go'); };
          (img && img.decode ? img.decode().catch(function () {}) : Promise.resolve()).then(go); setTimeout(go, 1500); // start on decode, never stuck
        });
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <div class="hdr-sentinel" aria-hidden="true" style="position:absolute;top:0;height:24px;width:1px;pointer-events:none"></div>
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <script is:inline>
      // header: transparent over the top of the page, solid once it scrolls
      (function () {
        var hdr = document.querySelector('.header'), sent = document.querySelector('.hdr-sentinel');
        if (hdr && sent && 'IntersectionObserver' in window) new IntersectionObserver(function (e) { hdr.classList.toggle('is-solid', !e[0].isIntersecting); }).observe(sent);
        else if (hdr) hdr.classList.add('is-solid');
      })();
    </script>
    <script is:inline>
      // reveal: headings split into masked lines (by <br>), quiet lift for leads and cards. Classes are added here only, so
      // without JS or with reduced motion nothing is hidden. The hero h1 is driven by the stage timeline instead.
      (function () {
        if (!matchMedia('(prefers-reduced-motion: no-preference)').matches || !('IntersectionObserver' in window)) return;
        document.querySelectorAll('main :is(h1, h2), .results__insta h3, .wb__head h3').forEach(function (h) {
          if (h.closest('.stage__sim')) return; // simulator head is driven by the stage timeline
          h.innerHTML = h.innerHTML.split(/<br[^>]*>/i).map(function (l, i) { return '<span class="ln"><span style="--i:' + i + '">' + l + '</span></span>'; }).join('');
          h.classList.add('is-split');
        });
        document.querySelectorAll('main .lead, main .mono, .svc-card, .review, .results__photos li, .trust__list li, .faq details, .results__cta .btn').forEach(function (el) {
          if (el.closest('#topo')) return;
          el.classList.add('reveal'); el.style.setProperty('--i', Array.prototype.indexOf.call(el.parentNode.children, el) % 6);
        });
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }); }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.is-split, .reveal').forEach(function (el) { if (!el.closest('#topo')) io.observe(el); });
      })();
    </script>
  </body>
</html>
