---
import Base from '../layouts/Base.astro';
import GalleryPro from '../components/GalleryPro.astro';
import Finale from '../components/Finale.astro';
---
<Base title="Galeria" description="Fotos de aplicações de película térmica, PPF, envelopamento e acessórios feitas pela Cuiabá Insulfilm em Cuiabá-MT." path="galeria/">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Galeria</p>
      <h1>Trabalhos recentes.</h1>
      <p>Película térmica, PPF, envelopamento e acessórios. Quer ver um carro parecido com o seu? Pergunte no WhatsApp.</p>
    </div>
  </section>
  <GalleryPro />
  <Finale message="Olá! Vi a galeria e quero um orçamento." />
</Base>
