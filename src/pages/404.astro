---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada" path="404/">
  <section class="section light">
    <div class="wrap">
      <p class="eyebrow">Erro 404</p>
      <h1>Essa página não existe.</h1>
      <p class="lead">O endereço pode estar errado ou a página foi movida.</p>
      <div class="actions"><a class="btn" href="/">Voltar ao início</a><a class="btn btn--ghost" href="/servicos/">Ver serviços</a></div>
    </div>
  </section>
</Base>
