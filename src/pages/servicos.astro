---
import Base from '../layouts/Base.astro';
import Icons from '../components/Icons.astro';
import Finale from '../components/Finale.astro';
import { wa, services, srcset } from '../data/site';

const shades = [
  { name: 'G70', vlt: '70%', front: 'ok', rear: 'ok', note: 'Quase transparente. Para-brisa e dianteiros.' },
  { name: 'G50', vlt: '50%', front: 'no', rear: 'ok', note: 'Leve escurecimento, boa visibilidade.' },
  { name: 'G35', vlt: '35%', front: 'no', rear: 'ok', note: 'Muito usada: conforto térmico sem perder a visão à noite.' },
  { name: 'G20', vlt: '20%', front: 'no', rear: 'ok', note: 'Intermediária: discrição com visibilidade razoável.' },
  { name: 'G5', vlt: '5%', front: 'no', rear: 'ok', note: 'Uma das mais escuras. Máxima privacidade.' },
  { name: 'G3', vlt: '3%', front: 'no', rear: 'ok', note: 'Privacidade extrema, quase opaca.' },
];
const label = { ok: ['tag tag--ok', 'Permitido'], no: ['tag', 'Não permitido'] } as const;
---
<Base title="Serviços" description="Insulfilm automotivo, PPF, envelopamento, som e multimídia, alarmes, engates e teto solar em Cuiabá. Tonalidades dentro da lei e aplicação com hora marcada." path="servicos/">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Serviços · 01–06</p>
      <h1>O que fazemos, e como fazemos.</h1>
      <p>Cada serviço abaixo tem um botão de orçamento com a mensagem pronta. Mande o modelo do carro e a gente responde com valor e prazo.</p>
    </div>
  </section>

  <section class="section light" style="padding-top:0">
  <div class="wrap">
    {services.map((s) => (
      <article class="svc" id={s.slug}>
        <div class="svc__media">
          <img src={s.image} srcset={srcset(s.image)} sizes="(max-width: 760px) 100vw, 50vw" alt={s.alt} width="900" height="900" loading="lazy" decoding="async" />
        </div>
        <div>
          <h2>{s.title}</h2>
          <p>{s.body}</p>
          <h3>O que inclui</h3>
          <ul>{s.includes.map((i) => <li>{i}</li>)}</ul>
          <p class="svc__ideal"><strong>Ideal para:</strong> {s.ideal}</p>
          {s.slug === 'insulfilm-automotivo' && (
            <>
              <h3>Tonalidades e a lei</h3>
              <p class="muted">O número da tonalidade é a luz que passa. O limite legal vale para vidro + película medidos juntos: no para-brisa e nos dianteiros vai G70; nos traseiros a tonalidade é escolha sua.</p>
              <table class="shade-table">
                <thead><tr><th>Película</th><th>Luz que passa</th><th>Dianteiros</th><th>Traseiros e vigia</th><th>Quando usar</th></tr></thead>
                <tbody>
                  {shades.map((r) => (
                    <tr>
                      <td>{r.name}</td>
                      <td>{r.vlt}</td>
                      <td><span class={label[r.front][0]}>{label[r.front][1]}</span></td>
                      <td><span class={label[r.rear][0]}>{label[r.rear][1]}</span></td>
                      <td class="muted">{r.note}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )}
          <a class="btn" href={wa(s.wa)} target="_blank" rel="noopener"><Icons name="wa" /> Pedir orçamento</a>
        </div>
      </article>
    ))}
  </div>
  </section>

  <Finale message="Olá! Tenho uma dúvida sobre um serviço." />
</Base>
