---
import Base from '../layouts/Base.astro';
import Icons from '../components/Icons.astro';
import { site, services, mapsLink } from '../data/site';
const a = site.address;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.mapsQuery)}&output=embed`;
---
<Base title="Contato" description="Fale com a Cuiabá Insulfilm: WhatsApp (65) 99340-1663, Av. Carmindo de Campos, 75, Dom Aquino, Cuiabá-MT. Orçamento e agendamento." path="contato/">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Contato</p>
      <h1>Orçamento em minutos.</h1>
      <p>O jeito mais rápido é o WhatsApp. Se preferir, preencha o formulário: ele monta a mensagem e abre a conversa para você.</p>
    </div>
  </section>

  <section class="section light">
    <div class="wrap contact">
      <div>
        <div class="nap">
          <div class="nap__row"><Icons name="phone" /><p><a href={site.whatsapp} target="_blank" rel="noopener">{site.phoneDisplay}</a><br /><span class="muted">Atendimento só pelo WhatsApp, de segunda a sábado</span></p></div>
          <div class="nap__row"><Icons name="pin" /><p>{a.street}, {a.neighborhood}<br />{a.city} - {a.state}, CEP {a.zip}<br /><span class="muted">{a.reference}</span><br /><a href={mapsLink} target="_blank" rel="noopener">Como chegar</a></p></div>
          <div class="nap__row"><Icons name="clock" /><p>{site.hours.map((h) => <>{h.days}: {h.time}<br /></>)}</p></div>
          <div class="nap__row"><Icons name="ig" /><p><a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a></p></div>
        </div>
        <iframe class="map" style="margin-top:1.6rem" src={mapSrc} loading="lazy" title="Mapa com a localização da loja" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </div>

      <form class="form" id="form-orcamento" data-wa={site.whatsapp} novalidate>
        <h2 style="margin:0">Pedir orçamento</h2>
        <p class="hint">Preenche, clica e a mensagem já sai pronta no seu WhatsApp.</p>
        <label>Seu nome<input name="nome" type="text" autocomplete="name" required /></label>
        <label>Serviço
          <select name="servico" required>
            {services.map((s) => <option value={s.title}>{s.title}</option>)}
            <option value="Outro">Outro</option>
          </select>
        </label>
        <label>Modelo e ano do carro<input name="veiculo" type="text" placeholder="Ex.: Hilux 2022" required /></label>
        <label>Mensagem (opcional)<textarea name="mensagem" placeholder="Tonalidade, data preferida, dúvidas…"></textarea></label>
        <button class="btn" type="submit"><Icons name="wa" /> Enviar pelo WhatsApp</button>
        <p class="hint" id="form-erro" role="alert" hidden>Preencha seu nome e o modelo do carro.</p>
      </form>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    var form = document.getElementById('form-orcamento');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var d = new FormData(form);
      var nome = String(d.get('nome') || '').trim();
      var veiculo = String(d.get('veiculo') || '').trim();
      var erro = document.getElementById('form-erro');
      if (!nome || !veiculo) { erro.hidden = false; return; }
      erro.hidden = true;
      var msg = ('Olá! Meu nome é ' + nome + '. Quero um orçamento de ' + d.get('servico') + ' para um ' + veiculo + '. ' + String(d.get('mensagem') || '').trim()).trim();
      window.open(form.dataset.wa + '?text=' + encodeURIComponent(msg), '_blank', 'noopener');
    });
  })();
</script>
