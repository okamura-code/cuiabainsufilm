---
import Base from '../layouts/Base.astro';
import Icons from '../components/Icons.astro';
import QuickQuote from '../components/QuickQuote.astro';
import VltSimulator from '../components/VltSimulator.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Quiz from '../components/Quiz.astro';
import GalleryPro from '../components/GalleryPro.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import { site, wa, services, faq, mapsLink, srcset } from '../data/site';
import '../styles/preview.css';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const flagship = services.filter((s) => ['insulfilm-automotivo', 'ppf', 'som-e-multimidia'].includes(s.slug));
const perks = [['sun', 'Conforto térmico'], ['shieldcheck', 'Mais segurança'], ['eye', 'Privacidade no seu dia a dia'], ['sparkle', 'Estilo e valorização']];
---
<Base title={site.name} path="" jsonLd={[faqLd]}>
  <Fragment slot="head">    <link rel="preload" as="image" href="/media/hero.webp" imagesrcset="/media/hero-640.webp 640w, /media/hero-1200.webp 1200w, /media/hero.webp 1920w" imagesizes="100vw" fetchpriority="high" /></Fragment>
  <section class="hero hero--v2">
    <div class="hero__media"><img class="hero__img" src="/media/hero.webp" srcset="/media/hero-640.webp 640w, /media/hero-1200.webp 1200w, /media/hero.webp 1920w" sizes="100vw" alt="SUV preto com vidros escurecidos ao pôr do sol em Cuiabá" width="1920" height="1080" fetchpriority="high" decoding="async" /></div>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="wrap hero__content">
      <p class="eyebrow">Películas automotivas e acessórios · {site.address.neighborhood}, Cuiabá-MT</p>
      <h1>Mais conforto. <span>Menos calor.</span></h1>
      <p class="lead">Seu carro mais protegido, confortável e com muito mais estilo. Películas Window Blue com garantia vitalícia, som e acessórios automotivos em Cuiabá.</p>
      <div class="actions">
        <a class="btn" href={wa('Olá! Quero um orçamento.')} target="_blank" rel="noopener"><Icons name="wa" /> Pedir orçamento</a>
        <a class="btn btn--ghost" href="#servicos">Explorar serviços <span aria-hidden="true">›</span></a>
      </div>
      <ul class="perks">
        {perks.map(([icon, label]) => <li><span class="perks__icon"><Icons name={icon} /></span>{label}</li>)}
      </ul>
    </div>
  </section>

  <QuickQuote />

  <section class="proof-band" aria-label="Destaques">
    <div class="wrap proof-band__grid">
      <a class="proof-item" href={mapsLink} target="_blank" rel="noopener"><Icons name="star" class="proof-item__icon" /><span><strong>5,0 no Google</strong><small>{site.rating.count} avaliações</small></span></a>
      <a class="proof-item" href="/contato/"><Icons name="pin" class="proof-item__icon" /><span><strong>{site.address.street}</strong><small>{site.address.neighborhood}, Cuiabá · {site.address.reference}</small></span></a>
      <a class="proof-item" href={site.whatsapp} target="_blank" rel="noopener"><Icons name="wa" class="proof-item__icon" /><span><strong>{site.phoneDisplay}</strong><small>Só WhatsApp · seg–sex 8h–18h, sáb 8h–12h</small></span></a>
    </div>
  </section>

  <section class="section light" id="servicos">
    <div class="wrap">
      <div class="gallery-head">
        <div class="section-head">
          <p class="eyebrow eyebrow--after">Soluções completas</p>
          <h2>Nossos serviços<span class="dot">.</span></h2>
          <p class="muted">Qualidade, tecnologia e as melhores marcas para o seu carro, em um só lugar.</p>
        </div>
        <a class="link-arrow" href="/servicos/">Ver todos os serviços <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid grid--3">
        {flagship.map((s) => (
          <article class="scard">
            <img src={s.image} srcset={srcset(s.image)} sizes="(max-width: 760px) 100vw, 33vw" alt={s.alt} width="800" height="600" loading="lazy" decoding="async" />
            <div class="scard__body">
              <span class="bar" aria-hidden="true"></span>
              <h3><a href={`/servicos/#${s.slug}`}>{s.title}</a></h3>
              <p>{s.short}</p>
              <ul class="tags">{s.tags.map((t) => <li><Icons name={t.icon} /> {t.label}</li>)}</ul>
              <a class="btn btn--dark btn--block" href={wa(s.wa)} target="_blank" rel="noopener">Pedir orçamento <span class="lime" aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <VltSimulator />
  <BeforeAfter />
  <Quiz />
  <GalleryPro />
  <Process />
  <Reviews />
  <Faq split />

  <section class="cta-band">
    <div class="wrap">
      <h2>Seu carro mais fresco ainda esta semana.</h2>
      <a class="btn" href={wa('Olá! Quero agendar uma aplicação.')} target="_blank" rel="noopener"><Icons name="wa" /> Agendar pelo WhatsApp</a>
    </div>
  </section>
</Base>
