---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import QuickQuote from '../components/QuickQuote.astro';
import Manifesto from '../components/Manifesto.astro';
import HeatFacts from '../components/HeatFacts.astro';
import VltSimulator from '../components/VltSimulator.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Quiz from '../components/Quiz.astro';
import ProtectionLevels from '../components/ProtectionLevels.astro';
import Process from '../components/Process.astro';
import GalleryPro from '../components/GalleryPro.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import Finale from '../components/Finale.astro';
import { site, faq } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={site.name} path="" jsonLd={[faqLd]}>
  <Fragment slot="head"><link rel="preload" as="image" media="(min-width: 900px) and (min-height: 640px) and (prefers-reduced-motion: no-preference)" href="/media/cine/f000.webp" fetchpriority="high" /><link rel="preload" as="image" media="(min-width: 768px) and (not ((min-width: 900px) and (min-height: 640px) and (prefers-reduced-motion: no-preference)))" href="/media/hero.webp" imagesrcset="/media/hero-1200.webp 1200w, /media/hero.webp 1920w" imagesizes="100vw" fetchpriority="high" /><link rel="preload" as="image" media="(max-width: 767px)" href="/media/hero-mobile.webp" imagesrcset="/media/hero-mobile-720.webp 720w, /media/hero-mobile.webp 1080w" imagesizes="100vw" fetchpriority="high" /></Fragment>
  <Hero />
  <QuickQuote />
  <Manifesto />
  <HeatFacts />
  <VltSimulator />
  <BeforeAfter />
  <Quiz />
  <ProtectionLevels />
  <Process />
  <GalleryPro />
  <Reviews />
  <Faq split />
  <Finale />
</Base>
