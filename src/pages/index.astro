---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import Results from '../components/Results.astro';
import Services from '../components/Services.astro';
import Trust from '../components/Trust.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { site, faq } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={site.name} path="" jsonLd={[faqLd]}>
  <Fragment slot="head"><link rel="preload" as="image" media="(min-width: 768px)" href="/media/hero/logo.webp" fetchpriority="high" /><link rel="preload" as="image" media="(max-width: 767px)" href="/media/hero/logo-640.webp" fetchpriority="high" /><link rel="preload" as="image" media="(min-width: 768px)" href="/media/hero/hero-composicao.webp" /><link rel="preload" as="image" media="(max-width: 767px)" href="/media/hero/hero-composicao-1200.webp" /></Fragment>
  <Stage />
  <Results />
  <Services />
  <Trust />
  <Reviews />
  <Faq split />
  <Contact />
</Base>
