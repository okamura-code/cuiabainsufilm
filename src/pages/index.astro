---
import Base from '../layouts/Base.astro';
import Icons from '../components/Icons.astro';
import VltSimulator from '../components/VltSimulator.astro';
import { site, wa, services, reviews, faq, gallery, mapsLink } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={site.name} path="" jsonLd={[faqLd]}>
  <section class="hero">
    <img class="hero__img" src="media/hero.jpg" alt="Aplicador de película térmica trabalhando no vidro de uma caminhonete" width="1920" height="1080" fetchpriority="high" decoding="async" />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="wrap hero__content">
      <p class="eyebrow">Dom Aquino · Cuiabá-MT</p>
      <h1>Cuiabá a 40&nbsp;°C. <span>Dentro do seu carro, não.</span></h1>
      <p class="lead">Película Window Blue com garantia vitalícia, PPF e som, aplicados por quem vive o calor daqui. Orçamento em minutos pelo WhatsApp.</p>
      <div class="actions">
        <a class="btn" href={wa('Olá! Quero um orçamento de película térmica.')} target="_blank" rel="noopener"><Icons name="wa" /> Pedir orçamento no WhatsApp</a>
        <a class="btn btn--ghost" href="servicos.html">Ver serviços</a>
      </div>
      <ul class="proof">
        <li><strong>5,0</strong> no Google · {site.rating.count} avaliações</li>
        <li><strong>Dom Aquino</strong> · ao lado da Av. Miguel Sutil</li>
        <li><strong>Revenda autorizada</strong> Window Blue · garantia vitalícia</li>
      </ul>
    </div>
    <div class="vlt-bar" aria-hidden="true"><span>70%</span><span>50%</span><span>35%</span><span>20%</span><span>5%</span></div>
  </section>

  <section class="section light" id="servicos">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Serviços</p>
        <h2>Do vidro à pintura, tudo no mesmo lugar.</h2>
        <p class="muted">Película térmica, PPF e som são o carro-chefe. Em volta deles, o que um carro de passeio ou uma caminhonete precisa para rodar em Cuiabá. Qualquer marca, qualquer modelo.</p>
      </div>
      <div class="grid grid--3">
        {services.map((s) => (
          <article class="card">
            <img src={s.image} alt={s.alt} width="800" height="800" loading="lazy" decoding="async" />
            <div class="card__body">
              <h3><a href={`servicos.html#${s.slug}`}>{s.title}</a></h3>
              <p>{s.short}</p>
              <a class="btn btn--ghost btn--sm" href={wa(s.wa)} target="_blank" rel="noopener">Pedir orçamento</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section light-2" id="como-funciona">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Como funciona</p>
        <h2>Três mensagens e o carro está agendado.</h2>
      </div>
      <ol class="steps">
        <li><h3>Mande o modelo do carro</h3><p>No WhatsApp, diga o carro e o serviço. Respondemos com valor e tonalidades em horário comercial.</p></li>
        <li><h3>Escolha dia e hora</h3><p>Atendemos só com hora marcada, na loja ou a domicílio em Cuiabá e região. Sem fila, sem espera.</p></li>
        <li><h3>Aplicação e certificado</h3><p>Reserve meio período. Você sai com a chancela nos vidros dianteiros e o certificado de garantia vitalícia Window Blue.</p></li>
      </ol>
    </div>
  </section>

  <VltSimulator />

  <section class="section light" id="avaliacoes">
    <div class="wrap">
      <div class="reviews-head">
        <div class="section-head">
          <p class="eyebrow eyebrow--line">Avaliações</p>
          <h2>Quem confia, recomenda.</h2>
          <p class="muted">Veja o que nossos clientes dizem sobre o atendimento e os serviços.</p>
        </div>
        <a class="gcard" href={mapsLink} target="_blank" rel="noopener" aria-label={`Nota 5,0 com ${site.rating.count} avaliações no Google`}>
          <Icons name="google" class="gcard__logo" />
          <div class="gcard__body">
            <strong>5,0</strong>
            <span class="stars" aria-hidden="true">★★★★★</span>
            <small>{site.rating.count} avaliações no Google</small>
          </div>
        </a>
      </div>
      <div class="grid grid--3">
        {reviews.map((r) => (
          <blockquote class="review">
            <div class="review__top"><span class="stars" aria-hidden="true">★★★★★</span><Icons name="google" class="review__g" /></div>
            <p>“{r.text}”</p>
            <footer><span class="avatar" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M4 20a8 8 0 0 1 16 0z"/></svg></span>{r.author}</footer>
          </blockquote>
        ))}
      </div>
      <div class="reviews-cta">
        <a class="btn btn--dark" href={mapsLink} target="_blank" rel="noopener">Ver todas as avaliações no Google <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section light-2" id="galeria">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Galeria</p>
        <h2>Trabalhos recentes.</h2>
      </div>
      <div class="masonry">
        {gallery.slice(0, 3).map((g) => (
          <figure><img src={g.src} alt={g.alt} width="1200" height="900" loading="lazy" decoding="async" /></figure>
        ))}
      </div>
      <div class="actions"><a class="btn btn--ghost" href="galeria.html">Ver galeria completa</a></div>
    </div>
  </section>

  <section class="section light faq" id="duvidas">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Dúvidas frequentes</p>
        <h2>Antes de perguntar no WhatsApp.</h2>
      </div>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>Seu carro mais fresco ainda esta semana.</h2>
      <a class="btn" href={wa('Olá! Quero agendar uma aplicação.')} target="_blank" rel="noopener"><Icons name="wa" /> Agendar pelo WhatsApp</a>
    </div>
  </section>
</Base>
