---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import QuickQuote from '../components/QuickQuote.astro';
import Manifesto from '../components/Manifesto.astro';
import HeatFacts from '../components/HeatFacts.astro';
import VltSimulator from '../components/VltSimulator.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Quiz from '../components/Quiz.astro';
import ProtectionLevels from '../components/ProtectionLevels.astro';
import Process from '../components/Process.astro';
import GalleryPro from '../components/GalleryPro.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import Finale from '../components/Finale.astro';
import { site, faq } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={site.name} path="" jsonLd={[faqLd]}>
  <Fragment slot="head"><link rel="preload" as="image" href="/media/hero-poster.webp" fetchpriority="high" /></Fragment>
  <Hero />
  <QuickQuote />
  <Manifesto />
  <HeatFacts />
  <VltSimulator />
  <BeforeAfter />
  <Quiz />
  <ProtectionLevels />
  <Process />
  <GalleryPro />
  <Reviews />
  <Faq split />
  <Finale />
</Base>
