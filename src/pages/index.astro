---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import { site, faq } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={site.name} path="" jsonLd={[faqLd]}>
  <Fragment slot="head"><link rel="preload" as="image" href="/media/hero/logo.webp" fetchpriority="high" /></Fragment>
  <Stage />
</Base>
