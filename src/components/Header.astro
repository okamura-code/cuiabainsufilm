---
import { site, wa } from '../data/site';
import Icons from './Icons.astro';
---
<header class="header">
  <div class="wrap">
    <a class="brand" href="/">
      <span class="brand__top">Cuiabá</span>
      <span class="brand__script">insulfilm</span>
      <span class="brand__sub">Som e acessórios</span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle sr-only" aria-label="Abrir menu" />
    <label for="nav-toggle" class="nav-btn"><span class="sr-only">Abrir menu</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </label>
    <nav class="nav" aria-label="Principal">
      <a href="/#servicos">Serviços</a>
      <a href="/#simulador">Simulador</a>
      <a href="/#galeria">Galeria</a>
      <a href="/#avaliacoes">Avaliações</a>
      <a href="/contato/">Contato</a>
      <a class="btn btn--wa" href={wa('Olá! Quero um orçamento.')} target="_blank" rel="noopener" aria-label={`WhatsApp ${site.phoneDisplay}`}><span class="wa-ring" aria-hidden="true"><Icons name="wa" /></span>{site.phoneDisplay}</a>
    </nav>
  </div>
</header>
<script is:inline>
  (function () {
    var brand = document.querySelector('.brand');
    if (!brand) return;
    document.querySelectorAll('.nav a[href^="/#"]').forEach(function (a) { a.addEventListener('click', function () { var t = document.getElementById('nav-toggle'); if (t) t.checked = false; }); });
    brand.addEventListener('click', function (e) {
      if (!document.querySelector('.hero')) return; // not on the home page: let the link navigate
      e.preventDefault();
      var toggle = document.getElementById('nav-toggle');
      if (toggle) toggle.checked = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
</script>
