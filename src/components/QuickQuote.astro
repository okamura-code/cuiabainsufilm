---
/* Quick quote bar: vehicle + service -> WhatsApp with both fields in the message.
   On phones it collapses into a <details> so it never fights the floating WhatsApp button. */
import Icons from './Icons.astro';
import { site, services } from '../data/site';
---
<section class="qq-wrap" aria-label="Orçamento rápido">
  <div class="wrap">
    <details class="qq" open>
      <summary class="qq__summary"><strong>Seu orçamento começa aqui</strong><span class="qq__hint">Toque para preencher</span></summary>
      <form class="qq__form" id="qq-form" data-wa={site.whatsapp}>
        <div class="qq__title"><strong>Seu orçamento<br />começa aqui</strong></div>
        <label class="qq__field">Qual é o seu carro?
          <span class="qq__input"><Icons name="car" /><input id="qq-car" name="carro" type="text" placeholder="Ex.: Hilux 2022" autocomplete="off" required /></span>
        </label>
        <label class="qq__field">Qual serviço procura?
          <span class="qq__input"><Icons name="sparkle" /><select id="qq-service" name="servico">{services.map((s) => <option value={s.title}>{s.title}</option>)}</select></span>
        </label>
        <button class="btn btn--lg" type="submit"><Icons name="wa" /> Consultar pelo WhatsApp <span aria-hidden="true">→</span></button>
        <p class="qq__error" id="qq-error" role="alert" hidden>Informe o modelo do carro.</p>
      </form>
    </details>
  </div>
</section>
<script is:inline>
  (function () {
    var box = document.querySelector('.qq');
    var form = document.getElementById('qq-form');
    if (!box || !form) return;
    if (matchMedia('(max-width: 760px)').matches) box.removeAttribute('open');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var car = form.carro.value.trim(), service = form.servico.value, err = document.getElementById('qq-error');
      if (!car) { err.hidden = false; form.carro.focus(); return; }
      err.hidden = true;
      var msg = 'Olá! Quero um orçamento de ' + service + ' para um ' + car + '.';
      window.open(form.dataset.wa + '?text=' + encodeURIComponent(msg), '_blank', 'noopener');
    });
  })();
</script>
