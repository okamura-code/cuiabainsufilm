---
import { gallery } from '../data/site';
interface Props { items?: typeof gallery; filters?: boolean; id?: string }
const { items = gallery, filters = true, id = 'bento' } = Astro.props;
const cats = [
  ['todos', 'Todos'],
  ['peliculas', 'Películas'],
  ['ppf', 'PPF'],
  ['som', 'Som e multimídia'],
];
---
{filters && (
  <div class="filters" role="group" aria-label="Filtrar galeria" data-for={id}>
    {cats.map(([v, l], i) => <button type="button" class:list={['filter', { 'is-active': i === 0 }]} data-cat={v} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}
  </div>
)}
<div class="bento" id={id}>
  {items.map((g, i) => (
    <figure class:list={['bento__item', { 'is-big': i === 0 }]} data-cat={g.cat}>
      <img src={g.src} alt={g.alt} width="1200" height="900" loading="lazy" decoding="async" />
      <figcaption class="bento__cap">{g.caption}</figcaption>
      <a class="bento__arrow" href="galeria.html" aria-label={`Ver mais: ${g.caption}`}><span aria-hidden="true">→</span></a>
    </figure>
  ))}
</div>
<script is:inline>
  (function () {
    document.querySelectorAll('.filters[data-for]').forEach(function (bar) {
      var grid = document.getElementById(bar.dataset.for);
      if (!grid) return;
      bar.addEventListener('click', function (e) {
        var b = e.target.closest('.filter');
        if (!b) return;
        bar.querySelectorAll('.filter').forEach(function (o) { o.classList.remove('is-active'); o.setAttribute('aria-pressed', 'false'); });
        b.classList.add('is-active');
        b.setAttribute('aria-pressed', 'true');
        var cat = b.dataset.cat, first = true;
        grid.querySelectorAll('.bento__item').forEach(function (f) {
          var show = cat === 'todos' || f.dataset.cat === cat;
          f.hidden = !show;
          f.classList.toggle('is-big', show && first);
          if (show) first = false;
        });
      });
    });
  })();
</script>
