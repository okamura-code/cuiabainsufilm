---
/* Services as "protection levels": four full-bleed panels. On desktop each is position:sticky so the next one slides over
   the previous (CSS only, scenes.css). On phones they stack. Images are the existing svc-* WebPs. */
import SceneHead from './SceneHead.astro';
import Icons from './Icons.astro';
import { levels, wa, srcset } from '../data/site';
---
<section class="levels" id="servicos" aria-labelledby="levels-title">
  <div class="wrap levels__intro">
    <SceneHead idx="05" eyebrow="Níveis de proteção">
      <span id="levels-title">Quatro camadas entre o sol e você<span class="dot">.</span></span>
      <Fragment slot="lead">Do vidro à carroceria. Cada nível resolve um incômodo diferente de quem dirige em Cuiabá. Comece pelo que mais pesa no seu dia.</Fragment>
    </SceneHead>
  </div>
  {/* desktop line-up (scenes.css pin): one sticky stage, scroll swaps the level; the .level articles below stay for SEO and phones */}
  <div class="lineup">
    <div class="wrap lineup__copy">
      <p class="level__idx mono" aria-hidden="true"><b id="lu-idx">{levels[0].idx}</b><span>/ 0{levels.length}</span></p>
      <h3 id="lu-title" aria-hidden="true">{levels[0].title}</h3>
      <p class="level__text" id="lu-text" aria-hidden="true">{levels[0].text}</p>
      <div class="actions"><a class="btn" id="lu-cta" href={wa(levels[0].wa)} aria-label={"Pedir orçamento: " + levels[0].title} target="_blank" rel="noopener"><Icons name="wa" /> Pedir orçamento</a></div>
    </div>
    <div class="lineup__media" aria-hidden="true">
      {levels.map((l, i) => (
        <img class:list={['lineup__img', { 'is-on': i === 0 }]} src={l.image} srcset={srcset(l.image)} sizes="50vw" alt="" width="1200" height="900" loading="lazy" decoding="async" data-idx={l.idx} data-title={l.title} data-text={l.text} data-wa={wa(l.wa)} />
      ))}
    </div>
  </div>
  {levels.map((l, i) => (
    <article class="level" id={`nivel-${l.idx}`} data-placeholder={l.placeholder ? 'real' : undefined}>
      <div class="level__media"><img src={l.image} srcset={srcset(l.image)} sizes="100vw" alt={l.alt} width="1200" height="900" loading="lazy" decoding="async" /></div>
      <div class="level__shade" aria-hidden="true"></div>
      <p class="level__ghost" aria-hidden="true">{l.idx}</p>
      <div class="wrap level__inner">
        <p class="level__idx mono"><b>{l.idx}</b><span>/ 0{levels.length} · {l.kicker}</span></p>
        <h2>{l.title}</h2>
        <div class="level__body">
          <div>
            <p class="level__text">{l.text}</p>
            <div class="actions">
              <a class="btn" href={wa(l.wa)} target="_blank" rel="noopener"><Icons name="wa" /> Pedir orçamento</a>
              <a class="btn btn--ghost" href={`/servicos/#${l.slug}`}>Detalhes <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <ul class="level__list">{l.includes.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </article>
  ))}
</section>
<script is:inline data-astro-rerun>
  (function () {
    var scene = document.getElementById('servicos'), imgs = scene && scene.querySelectorAll('.lineup__img');
    var pin = matchMedia('(min-width: 900px) and (min-height: 640px) and (prefers-reduced-motion: no-preference)');
    if (!imgs || !imgs.length) return;
    var idx = document.getElementById('lu-idx'), title = document.getElementById('lu-title'), text = document.getElementById('lu-text'), cta = document.getElementById('lu-cta');
    var cur = 0, ticking = false;
    var hh = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-h")) || 68;
    var onScroll = function () {
      if (!scene.isConnected) { removeEventListener("scroll", onScroll); pin.removeEventListener("change", onScroll); return; }
      if (ticking || !pin.matches) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        var span = scene.offsetHeight - window.innerHeight + hh; // same progress as the simulator pin
        if (span <= 0) return;
        var p = Math.min(1, Math.max(0, (hh - scene.getBoundingClientRect().top) / span));
        var i = Math.min(imgs.length - 1, Math.floor(p * imgs.length));
        if (i === cur) return;
        imgs[cur].classList.remove('is-on'); imgs[i].classList.add('is-on'); cur = i;
        var d = imgs[i].dataset;
        idx.textContent = d.idx; title.textContent = d.title; text.textContent = d.text; cta.href = d.wa; cta.setAttribute("aria-label", "Pedir orçamento: " + d.title);
      });
    };
    addEventListener('scroll', onScroll, { passive: true });
    pin.addEventListener("change", onScroll);
    onScroll();
  })();
</script>
