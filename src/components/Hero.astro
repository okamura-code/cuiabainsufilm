---
/* Full-screen hero. Background: a car accelerating into light streaks (raw/hero-video, cut at 5.2 s before the AI's misspelled logo,
   re-encoded to public/media/hero-video.mp4). Plays once and freezes on its last frame; the real logo (logo-hero.webp, black bg +
   mix-blend-mode: screen) fades in centred over the last 0.8 s where the AI logo would form, then slides aside and the text enters.
   Poster = frame 0 (the LCP image).
   Concept: "Lá fora é Cuiabá. Aqui dentro, não." */
import Icons from './Icons.astro';
import { site, wa, concept } from '../data/site';
const perks = ['Conforto térmico', 'Mais segurança', 'Privacidade', 'Estilo e valorização'];
---
<section class="hero" id="topo">
  <div class="hero__media">
    <video class="hero__video" autoplay muted  playsinline preload="auto" poster="/media/hero-poster.webp" aria-hidden="true"><source src="/media/hero-video.mp4" type="video/mp4" /></video>
    <img class="hero__logo" src="/media/logo-hero.webp" alt="" width="1400" height="983" decoding="async" aria-hidden="true" />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__top" aria-hidden="true"><span class="mono">{concept.tagline}</span><span class="mono">{concept.coords}</span></div>
  <div class="wrap hero__content">
    <h1><span class="line"><span>Lá fora</span></span><span class="line"><span>é Cuiabá.</span></span><span class="line"><span>Aqui dentro,<br class="br-m" /> <span class="accent">não.</span></span></span></h1>
    <p class="lead">{concept.sub} Películas Window Blue com garantia vitalícia, em {site.address.neighborhood}.</p>
    <div class="actions">
      <a class="btn btn--lg" href={wa('Olá! Vi o site e quero o meu carro assim. Pode me passar um orçamento?')} target="_blank" rel="noopener" data-magnetic><Icons name="wa" /> {concept.ctaPrimary}</a>
      <a class="btn btn--lg btn--ghost" href="#antes-depois" data-magnetic>{concept.ctaSecondary} <span aria-hidden="true">↓</span></a>
    </div>
    <ul class="perks">{perks.map((p) => <li>{p}</li>)}</ul>
  </div>
  <a class="hero__cue" href="#manifesto"><span>{concept.cue}</span><i aria-hidden="true"></i></a>
</section>
<script is:inline data-astro-rerun>
  (function () {
    var hero = document.getElementById('topo'), v = hero && hero.querySelector('.hero__video'), logo = hero && hero.querySelector('.hero__logo');
    if (!hero || !v || !logo) return;
    var done = false;
    function finish() { if (done) return; done = true; logo.classList.add('is-on'); hero.classList.add('is-set'); hero.classList.remove('is-wait'); }
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.pause(); finish(); return; }
    hero.classList.add('is-wait'); // text waits for the logo
    v.addEventListener('timeupdate', function () { if (v.duration && v.duration - v.currentTime <= 0.8) logo.classList.add('is-on'); });
    v.addEventListener('ended', function () { setTimeout(finish, 900); }); // hold the logo centred, then make room for the text
    setTimeout(finish, 7000); // a stalled video never hides the CTA
    var p = v.play(); if (p && p.catch) p.catch(finish); // autoplay blocked (data saver): straight to the final state
  })();
</script>
