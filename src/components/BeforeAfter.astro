---
/* Before/after comparator on the same photo and framing: clean source vs. G5 frame.
   The divider is a native range input, so mouse, touch and keyboard all work.
   v3: full-bleed dark scene with a ghost title and a live position readout; the range mechanics are unchanged. */
import Icons from './Icons.astro';
import SceneHead from './SceneHead.astro';
import { wa } from '../data/site';
const before = '/media/porsche/frames/lateral-esquerda/original.webp';
const after = '/media/porsche/frames/lateral-esquerda/g5.webp';
---
<section class="ba-scene" id="antes-depois">
  <p class="ba-scene__ghost" aria-hidden="true">Veja</p>
  <div class="wrap">
    <SceneHead idx="04" eyebrow="Antes e depois" center>
      Arraste<span class="dot">.</span> Veja a diferença<span class="dot">.</span>
      <Fragment slot="lead">Mesma foto, mesmo ângulo. À esquerda, vidro limpo. À direita, película G5.</Fragment>
    </SceneHead>
    <div class="ba-bar" aria-hidden="true"><span class="mono">Divisória</span><output id="ba-out">50%</output></div>
    <div class="ba" id="ba" style="--pos:50%">
      <img class="ba__img" src={before} alt="Porsche 911 branco sem película, lateral esquerda" width="1500" height="750" loading="lazy" decoding="async" />
      <span class="ba__after"><img class="ba__img" src={after} alt="O mesmo carro com película G5" width="1500" height="750" loading="lazy" decoding="async" /></span>
      <span class="ba__tag ba__tag--before">Sem película</span>
      <span class="ba__tag ba__tag--after">Com película G5</span>
      <span class="ba__line" aria-hidden="true"><span class="ba__knob"><Icons name="arrows" /></span></span>
      <label for="ba-range" class="sr-only">Posição da divisória entre sem película e com película</label>
      <input class="ba__range" id="ba-range" type="range" min="0" max="100" value="50" step="1" />
    </div>
    <p class="mono" style="margin:.8rem 0 0">Comparação ilustrativa · película G5 sobre a mesma foto</p>
    <div class="center-cta">
      <a class="btn btn--lg" href={wa('Olá! Vi o comparador no site e quero esse resultado no meu carro.')} target="_blank" rel="noopener"><Icons name="wa" /> Quero esse resultado</a>
    </div>
  </div>
</section>
<script is:inline data-astro-rerun>
  (function () {
    var box = document.getElementById('ba'), r = document.getElementById('ba-range'), out = document.getElementById('ba-out');
    if (!box || !r) return;
    var update = function () { box.style.setProperty('--pos', r.value + '%'); if (out) out.textContent = r.value + '%'; };
    r.addEventListener('input', update);
    update();
  })();
</script>
