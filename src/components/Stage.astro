---
/* v8 opening, hero v2 (approved 08/11): one pinned stage. Logo on black → hero: copy on the left over the owner's
   composition (facade on the right, soft edges baked in) → hold → the Porsche, cut from that same image, travels to the
   simulator photo while the facade fades → simulator UI and tint demo on scroll.
   hero-vazio.webp = the owner's image with the garage emptied (scripts/hero-empty.mjs). The car is the owner's transparent Porsche
   (porsche-frente-escuro.webp, scripts/car-garage.mjs) on the simulator's 1500x750 frame canvas, bbox-matched to frente/g70: one
   image travels and dissolves into the real frame on arrival. Reduced motion / no JS: blocks stacked, car parked. */
import Icons from './Icons.astro';
import VltSimulator from './VltSimulator.astro';
import { site } from '../data/site';
// frame canvas (1500x750) inside the 1915x821 composition: the frame car (x 252–1247) lands on the owner's car (x 1049–1360)
const car = { left: 50.653, top: 58.587, width: 24.491 };
---
<section class="stage" id="topo" aria-label="Abertura">
  <div class="stage__pin">
    <div class="stage__brand">
      <picture><source media="(max-width: 767px)" srcset="/media/hero/logo-640.webp" /><img src="/media/hero/logo.webp" alt="Cuiabá Insulfilm Som e Acessórios" width="1196" height="729" fetchpriority="high" decoding="async" /></picture>
      <a class="stage__cue mono" href="#loja">Role para conhecer a loja <span aria-hidden="true">↓</span></a>
    </div>
    <div class="stage__shop" id="loja">
      <div class="stage__text">
        <p class="stage__eyebrow mono">Cuiabá Insulfilm</p>
        <h1>Mais conforto.<br />Mais proteção.<br /><span class="accent">Seu carro,</span><br />do seu jeito.</h1>
        <p class="lead">Películas, PPF e acessórios para cuidar do seu carro.</p>
        <a class="btn" href={site.whatsapp} target="_blank" rel="noopener"><Icons name="wa" /> Pedir orçamento</a>
        <a class="stage__explore mono" href="#simulador"><span aria-hidden="true">⌄</span> Role para explorar</a>
      </div>
      <div class="stage__hero">
        <div class="stage__plate">
          <picture>
            <source media="(max-width: 767px)" srcset="/media/hero/hero-vazio-1200.webp" />
            <img class="stage__facade" src="/media/hero/hero-vazio.webp" width="1915" height="821" alt="Fachada da Cuiabá Insulfilm em Dom Aquino, com a garagem aberta" decoding="async" />
          </picture>
          <i class="stage__shadow" aria-hidden="true"></i>
          <div class="stage__car" style={`left:${car.left}%;top:${car.top}%;width:${car.width}%`}>
            <img src="/media/hero/porsche-frente-escuro.webp" width="1500" height="750" alt="Porsche 911 branco dentro da garagem" decoding="async" />
          </div>
        </div>
      </div>
    </div>
    <div class="stage__sim">
      <VltSimulator />
    </div>
  </div>
</section>
<script is:inline>
  (function () {
    var sec = document.getElementById('topo');
    if (!sec || !matchMedia('(prefers-reduced-motion: no-preference)').matches) return; // stacked fallback stays
    sec.dataset.stage = '';
    var q = function (s) { return sec.querySelector(s); };
    var brand = q('.stage__brand'), facade = q('.stage__facade'), shadow = q('.stage__shadow'), text = q('.stage__text');
    var car = q('.stage__car'), plate = q('.stage__plate'), sim = q('.stage__sim'), simEl = document.getElementById('simulador');
    var photo = q('.vlt__photo'), target = document.getElementById('vlt-base');
    var ui = sim.querySelectorAll('.scene-head, .vlt__views, .vlt__caption, .vlt__panel');
    var pct = { l: parseFloat(car.style.left) / 100, t: parseFloat(car.style.top) / 100, w: parseFloat(car.style.width) / 100 };
    var clamp = function (x) { return x < 0 ? 0 : x > 1 ? 1 : x; };
    var seg = function (p, a, b) { var t = clamp((p - a) / (b - a)); return t * t * (3 - 2 * t); };
    var lastQ = -2, ticking = false;
    function rects() { // car rest rect from the plate (transforms never pollute it) and its destination (the simulator photo), live
      var P = plate.getBoundingClientRect(), t = target.getBoundingClientRect();
      return { S: { l: P.left + P.width * pct.l, t: P.top + P.height * pct.t, w: P.width * pct.w }, T: { l: t.left, t: t.top, w: t.width } };
    }
    function draw() {
      ticking = false;
      var span = sec.offsetHeight - innerHeight; if (span <= 0) return;
      var p = clamp(-sec.getBoundingClientRect().top / span);
      var b = 1 - seg(p, 0.06, 0.14);
      brand.style.opacity = b; brand.style.visibility = b > 0 ? 'visible' : 'hidden';
      var fIn = seg(p, 0.1, 0.2), fOut = seg(p, 0.42, 0.6);
      facade.style.opacity = fIn * (1 - fOut); shadow.style.opacity = fIn * (1 - fOut);
      var tOut = seg(p, 0.4, 0.46), t = fIn - tOut; // hero copy: in with the facade, out just before the car leaves
      text.style.opacity = t; text.style.visibility = t > 0 ? 'visible' : 'hidden';
      text.style.transform = 'translateX(' + (-(1 - fIn) * 24 - tOut * 24).toFixed(1) + 'px)';
      var R = rects(), S = R.S, T = R.T, k = seg(p, 0.4, 0.6), s = T.w / S.w; // car: garage → photo rect (position and size lerp)
      car.style.transform = 'translate(' + ((T.l - S.l) * k).toFixed(1) + 'px,' + ((T.t - S.t) * k).toFixed(1) + 'px) scale(' + (1 + (s - 1) * k).toFixed(4) + ')';
      car.style.opacity = fIn * (1 - seg(p, 0.58, 0.64)); // dissolves into the simulator frame once the photo is fully in
      sim.style.visibility = p >= 0.5 ? 'visible' : 'hidden';
      photo.style.opacity = seg(p, 0.52, 0.6);
      var u = seg(p, 0.56, 0.66);
      ui.forEach(function (el) { el.style.opacity = u; el.style.transform = 'translateY(' + ((1 - u) * 20).toFixed(1) + 'px)'; });
      var tint = p < 0.5 ? -1 : seg(p, 0.68, 1);
      if (tint !== lastQ) { lastQ = tint; simEl.dispatchEvent(new CustomEvent('stage:tint', { detail: tint })); }
    }
    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(draw); } }
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    addEventListener('load', onScroll);
    // "Simulador" links land on the simulator state, not on the start of the pinned section
    document.querySelectorAll('a[href="#simulador"]').forEach(function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); scrollTo({ top: sec.offsetTop + 0.66 * (sec.offsetHeight - innerHeight), behavior: 'smooth' }); });
    });
    draw();
  })();
</script>
