---
/* Trust: real photo of the cutting plotter, the shop's verifiable differentials and a Window Blue card: the lifetime-warranty
   seal and logo supplied by the owner, manufacturer figures attributed as such. Real reviews follow in Reviews.astro. */
import Icons from './Icons.astro';
const items = [
  ['sparkle', 'Corte computadorizado', 'Precisão no recorte e atenção ao acabamento. Consulte disponibilidade para seu veículo.'],
  ['shieldcheck', 'Revenda autorizada Window Blue', 'Películas com certificado de garantia vitalícia, conforme as condições e a cobertura da linha aplicada.'],
  ['car', 'Interior protegido', 'Forros de proteção no interior enquanto o serviço acontece, como nos vídeos acima.'],
  ['pin', 'Atendimento que cabe na sua rotina', 'Na loja ou a domicílio em Cuiabá e região, mediante agendamento.'],
  ['calendar', 'Também aos sábados', 'Segunda a sexta, 8h às 18h. Sábado, 8h às 12h.'],
];
---
<section class="section light trust" id="confianca">
  <div class="wrap trust__grid">
    <figure class="trust__photo">
      <img src="/media/trust/corte-computadorizado.webp" alt="Máquina de corte computadorizado de película na loja" width="960" height="1200" loading="lazy" decoding="async" />
      <figcaption class="mono">Corte computadorizado</figcaption>
    </figure>
    <div>
      <h2>Confiança<span class="dot">.</span></h2>
      <p class="lead">Tecnologia no corte. Cuidado em cada detalhe.</p>
      <ul class="trust__list">
        {items.map(([icon, t, d]) => <li><Icons name={icon} /><div><strong>{t}</strong><span>{d}</span></div></li>)}
      </ul>
      <aside class="wb">
        <div class="wb__head">
          <img class="wb__seal" src="/media/trust/selo-garantia-vitalicia.webp" alt="Selo Garantia Vitalícia, 100% original product" width="800" height="790" loading="lazy" decoding="async" />
          <div>
            <h3>Películas Window Blue e Window Premium</h3>
            <p>Duas linhas da mesma fabricante, com acabamentos e desempenhos diferentes. Na loja, você vê as amostras e escolhe pelo seu carro.</p>
          </div>
        </div>
        <div class="wb__lines">
          <article class="wb__line">
            <span class="wb__logo"><img src="/media/trust/windowblue-logo.webp" alt="Window blue Infrared Control" width="800" height="173" loading="lazy" decoding="async" /></span>
            <ul>
              <li>99 % de bloqueio dos raios ultravioleta</li>
              <li>92 % de rejeição dos raios infravermelhos</li>
              <li>Até 75 % de transparência</li>
            </ul>
          </article>
          <article class="wb__line">
            <span class="wb__logo wb__logo--dark"><img src="/media/trust/windowpremium-logo.webp" alt="Window premium" width="800" height="267" loading="lazy" decoding="async" /></span>
            <ul>
              <li>Linha mais clara, com alta rejeição de calor e visual discreto</li>
              <li>Variante Premium Clear IR99: até 99 % de rejeição IR e 99 % UV (só essa variante)</li>
              <li>Demais versões: dados da ficha de cada película</li>
            </ul>
          </article>
        </div>
        <p class="wb__note">Dados do fabricante (sommafilms.windowblue.com, consultados em 08/11/2026). Rejeição de infravermelho não é o mesmo que redução total do calor. Garantia vitalícia na linha automotiva conforme o certificado e as condições da linha aplicada: desbotamento, descascamento e perda das características técnicas.</p>
      </aside>
    </div>
  </div>
</section>
