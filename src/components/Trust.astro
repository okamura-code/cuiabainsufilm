---
/* Trust: real photo of the cutting plotter, the shop's verifiable differentials and a Window Blue card: the lifetime-warranty
   seal and logo supplied by the owner, manufacturer figures attributed as such. Real reviews follow in Reviews.astro. */
import Icons from './Icons.astro';
const items = [
  ['sparkle', 'Corte computadorizado', 'Recorte preciso para qualquer modelo, com atenção ao acabamento.'],
  ['shieldcheck', 'Revenda autorizada Window Blue', 'Películas com certificado de garantia vitalícia, conforme as condições e a cobertura da linha aplicada.'],
  ['car', 'Interior protegido', 'Forros de proteção no interior enquanto o serviço acontece, como nos vídeos acima.'],
  ['pin', 'Atendimento que cabe na sua rotina', 'Na loja ou a domicílio em Cuiabá e região, mediante agendamento.'],
  ['calendar', 'Também aos sábados', 'Segunda a sexta, 8h às 18h. Sábado, 8h às 12h.'],
];
---
<section class="section light trust" id="confianca">
  <div class="wrap trust__grid">
    <figure class="trust__photo">
      <img src="/media/trust/corte-computadorizado.webp" alt="Máquina de corte computadorizado de película na loja" width="720" height="858" loading="lazy" decoding="async" />
      <figcaption class="mono">Máquina de corte da loja</figcaption>
    </figure>
    <div>
      <h2>Confiança<span class="dot">.</span></h2>
      <p class="lead">Tecnologia no corte. Cuidado em cada detalhe.</p>
      <ul class="trust__list">
        {items.map(([icon, t, d]) => <li><Icons name={icon} /><div><strong>{t}</strong><span>{d}</span></div></li>)}
      </ul>
      <aside class="wb">
        <img class="wb__seal" src="/media/trust/selo-garantia-vitalicia.webp" alt="Selo Garantia Vitalícia, 100% original product" width="800" height="790" loading="lazy" decoding="async" />
        <div class="wb__body">
          <span class="wb__logo"><img src="/media/trust/windowblue-logo.webp" alt="Window blue Infrared Control" width="800" height="285" loading="lazy" decoding="async" /></span>
          <h3>Película Window Blue, com garantia vitalícia</h3>
          <ul>
            <li>Retém de 93 % a 100 % dos raios infravermelhos</li>
            <li>Bloqueia mais de 99 % dos raios UV (UVA e UVB)</li>
            <li>Transparências disponíveis: VLT 05, 20, 35, 50 e 75</li>
          </ul>
          <p class="wb__note">Dados do fabricante (Bluetech Window Films). O certificado de garantia é entregue na aplicação, com as condições da linha.</p>
        </div>
      </aside>
    </div>
  </div>
</section>
