---
/* Closing scene, shared by the home and the inner pages. Headline strokes in and fills on scroll (scenes.css). */
import Icons from './Icons.astro';
import { site, wa, concept, mapsLink } from '../data/site';
const { message = 'Olá! Quero um orçamento para proteger meu carro.' } = Astro.props as { message?: string };
---
<section class="finale" id="final" aria-labelledby="finale-title">
  <div class="wrap finale__inner">
    <p class="mono">Última chamada · {site.address.neighborhood}, Cuiabá–MT</p>
    <h2 id="finale-title"><span class="line"><span>{concept.finale.a}<br /><span class="accent">{concept.finale.b}</span></span></span></h2>
    <p class="lead">Mande o modelo do carro. Respondemos com valor fechado e horário, de segunda a sábado.</p>
    <div class="actions" style="justify-content:center">
      <a class="btn btn--lg" href={wa(message)} target="_blank" rel="noopener" data-magnetic><Icons name="wa" /> {concept.finale.cta}</a>
      <a class="btn btn--lg btn--ghost" href={mapsLink} target="_blank" rel="noopener" data-magnetic><Icons name="pin" /> Como chegar</a>
    </div>
    <ul class="finale__meta" style="list-style:none;padding:0">
      <li class="mono">{site.address.street}</li>
      <li class="mono">Seg–sex 8h–18h · Sáb 8h–12h</li>
      <li class="mono">{site.phoneDisplay}</li>
    </ul>
  </div>
</section>
