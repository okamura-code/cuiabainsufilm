---
/* Real Google reviews (text and names as published; names authorised by the owner, 2026-11-04).
   Rating value and count stay hidden until the owner confirms the current numbers. */
import Icons from './Icons.astro';
import { reviews, mapsLink } from '../data/site';
---
<section class="section light reviews" id="avaliacoes">
  <div class="wrap">
    <div class="reviews-head">
      <div>
        <p class="mono">Quem já passou por aqui</p>
        <h2>Quem confia, recomenda<span class="dot">.</span></h2>
        <p class="lead">Avaliações públicas no Google, com nome e data. Sem depoimento inventado.</p>
      </div>
      <a class="btn btn--dark" href={mapsLink} target="_blank" rel="noopener"><Icons name="google" class="ico" /> Ver avaliações no Google</a>
    </div>
    <div class="reviews-grid">
      {reviews.map((r) => (
        <blockquote class="review">
          <div class="review__top"><span class="stars" aria-hidden="true">★★★★★</span><Icons name="google" class="review__g" /></div>
          <p>“{r.text}”</p>
          <footer><span class="avatar" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M4 20a8 8 0 0 1 16 0z"/></svg></span><span><strong>{r.author}</strong><br /><small>{r.meta}</small></span></footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
