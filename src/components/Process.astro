---
/* Five "fichas": diagnóstico, escolha, preparação, aplicação, acabamento. Data in src/data/site.ts (process).
   Cards flagged data-placeholder="real" still use illustrative photos and should be swapped for the shop's own. */
import Icons from './Icons.astro';
import SceneHead from './SceneHead.astro';
import { wa, srcset, process } from '../data/site';
---
<section class="section light" id="processo">
  <div class="wrap">
    <div class="process-head">
      <SceneHead idx="06" eyebrow="Bastidores">
        Por dentro do cuidado<span class="dot">.</span>
        <Fragment slot="lead">Cinco etapas, uma por vez. O resultado está nos detalhes que você nem sempre vê.</Fragment>
      </SceneHead>
      <p class="process-aside">Hora marcada<br />Um carro por vez<br />Valor fechado antes</p>
    </div>
    <ol class="pcards">
      {process.map((s) => (
        <li class="pcard" data-placeholder={s.placeholder ? 'real' : undefined}>
          <img src={s.img} srcset={s.square ? undefined : srcset(s.img)} sizes="(max-width: 760px) 100vw, 20vw" alt={s.alt} width="1200" height="900" loading="lazy" decoding="async" />
          {s.placeholder && <span class="pcard__flag">Foto ilustrativa</span>}
          <div class="pcard__body">
            <div class="pcard__top"><span class="pcard__num">{s.n}</span><Icons name={s.icon} class="pcard__icon" /></div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="center-cta">
      <a class="btn btn--dark" href={wa('Olá! Quero falar com a equipe sobre uma aplicação.')} target="_blank" rel="noopener"><Icons name="wa" /> Falar com a equipe</a>
    </div>
  </div>
</section>
