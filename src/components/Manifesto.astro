---
/* Oversized manifesto. Each word is a span so CSS scroll-driven animation can light them up (scenes.css).
   Without scroll-timeline support the words simply render lit. */
import { concept } from '../data/site';
const words = concept.manifesto.split(' ');
const accent = concept.manifestoAccent.toLowerCase();
---
<section class="manifesto" id="manifesto" aria-label="Manifesto">
  <div class="wrap">
    <p class="mono" style="margin:0 0 2rem">Manifesto · Dirigir em Cuiabá</p>
    <p class="manifesto__text">
      {words.map((w) => <span class:list={['w', { 'w--accent': w.toLowerCase().replace(/[.,]/g, '') === accent }]}>{w} </span>)}
    </p>
    <div class="manifesto__foot">
      <span class="mono">Uma das capitais mais quentes do Brasil</span>
      <span class="mono">Sol forte o ano inteiro</span>
      <span class="mono">Proteção começa no vidro</span>
    </div>
  </div>
</section>
