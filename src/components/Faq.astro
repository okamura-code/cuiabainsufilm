---
/* Accessible accordion: native <details>/<summary>. Content comes from the confirmed answers in src/data/site.ts. */
import Icons from './Icons.astro';
import SceneHead from './SceneHead.astro';
import { faq, wa } from '../data/site';
const { split = false } = Astro.props as { split?: boolean };
---
<section class:list={['section light-2 faq', { 'faq--split': split }]} id="duvidas">
  <div class:list={['wrap', { 'faq-grid': split }]}>
    <div class="faq-side">
      <SceneHead idx="09" eyebrow="Dúvidas frequentes">
        Antes de decidir<span class="dot">.</span>
        <Fragment slot="lead">Lei, garantia, prazo, pagamento. Respostas curtas, sem rodeio.</Fragment>
      </SceneHead>
      {split && (
        <div class="faq-card">
          <Icons name="chat" class="faq-card__icon" />
          <strong>Prefere conversar?</strong>
          <p>A equipe ajuda você a escolher.</p>
          <a class="btn" href={wa('Olá! Tenho uma dúvida antes de decidir a película.')} target="_blank" rel="noopener"><Icons name="wa" /> Chamar no WhatsApp</a>
        </div>
      )}
    </div>
    <div class="faq-list">
      {faq.map((f, i) => (
        <details open={i === 0 && split}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
