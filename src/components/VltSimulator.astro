---
/* The one tint simulator (kept from v3): four real-render views × six tonalities, crossfaded frames.
   v8: lives inside the opening stage (Stage.astro). The stage drives the scroll demo by dispatching
   `stage:tint` on #simulador with detail q in 0..1 (G70→G3) or -1 to re-arm after a manual choice.
   Touching the range switches to manual for the rest of the pass; scrolling back above the simulator re-arms. */
import Icons from './Icons.astro';
import SceneHead from './SceneHead.astro';
import { wa } from '../data/site';
const views = [
  { id: 'frente', label: 'Frente', alt: 'Porsche 911 branco visto de frente' },
  { id: 'lateral-esquerda', label: 'Lateral esq.', alt: 'Porsche 911 branco visto pela lateral esquerda' },
  { id: 'lateral-direita', label: 'Lateral dir.', alt: 'Porsche 911 branco visto pela lateral direita' },
  { id: 'traseira', label: 'Traseira', alt: 'Porsche 911 branco visto por trás' },
];
---
<div class="vlt-embed" id="simulador">
  <div class="wrap">
    <div class="vlt">
      <div class="vlt__stage">
        <SceneHead eyebrow="Simulador de tonalidade">
          Escolha o tom<span class="dot">.</span> Veja antes de aplicar<span class="dot">.</span>
          <Fragment slot="lead">Explore as vistas e experimente as tonalidades na Porsche.</Fragment>
        </SceneHead>
        <div class="vlt__views" role="group" aria-label="Vista do carro">
          {views.map((v, i) => (
            <button type="button" class:list={['vlt__view', { 'is-active': i === 0 }]} data-view={v.id} data-alt={v.alt} aria-pressed={i === 0 ? 'true' : 'false'}>{v.label}</button>
          ))}
        </div>
        <div class="vlt__photo">
          <img class="vlt__base" id="vlt-base" src={`/media/porsche/frames/${views[0].id}/g70.webp`} alt={views[0].alt} width="1500" height="750" decoding="async" />
          <img class="vlt__next" id="vlt-next" src={`/media/porsche/frames/${views[0].id}/g70.webp`} alt="" width="1500" height="750" decoding="async" loading="lazy" aria-hidden="true" />
        </div>
        <p class="vlt__caption mono">Simulação visual · a aparência real varia conforme o vidro e a iluminação<span class="vlt__hint"> · Role para escurecer ↓</span></p>
      </div>
      <div class="vlt__panel">
        <div class="vlt__readout"><output for="vlt-range" id="vlt-out">G70</output><small>Tonalidade</small></div>
        <p class="vlt__vlt">Luz que passa: <b id="vlt-pct">70%</b></p>
        <label for="vlt-range" class="sr-only">Tonalidade da película</label>
        <input type="range" id="vlt-range" min="0" max="5" step="1" value="5" aria-valuetext="G70, 70% de luz passa" />
        <div class="vlt__ticks" aria-hidden="true"><span>G3</span><span>G5</span><span>G20</span><span>G35</span><span>G50</span><span>G70</span></div>
        <p class="vlt__desc" id="vlt-desc"></p>
        <a class="btn btn--block" id="vlt-cta" href={wa('Olá! Quero orientação sobre a tonalidade ideal para meu carro.')} target="_blank" rel="noopener"><Icons name="wa" /> Orientação pelo WhatsApp</a>
      </div>
    </div>
  </div>
</div>
<script is:inline>
  (function () {
    var shades = [
      { g: 'G3', vlt: 3, desc: 'Privacidade extrema, quase opaca.' },
      { g: 'G5', vlt: 5, desc: 'Uma das mais escuras do mercado. Máxima privacidade.' },
      { g: 'G20', vlt: 20, desc: 'Discrição com visibilidade razoável.' },
      { g: 'G35', vlt: 35, desc: 'Equilíbrio entre privacidade e visibilidade.' },
      { g: 'G50', vlt: 50, desc: 'Leve escurecimento, boa visibilidade.' },
      { g: 'G70', vlt: 70, desc: 'Quase transparente. A usada no para-brisa e nos dianteiros.' },
    ];
    var range = document.getElementById('vlt-range'), out = document.getElementById('vlt-out'), pct = document.getElementById('vlt-pct'), desc = document.getElementById('vlt-desc');
    var base = document.getElementById('vlt-base'), next = document.getElementById('vlt-next'), cta = document.getElementById('vlt-cta'), scene = document.getElementById('simulador');
    var buttons = document.querySelectorAll('.vlt__view'), view = document.querySelector('.vlt__view.is-active');
    if (!range || !out || !base || !next || !view) return;
    var ctaBase = cta ? cta.href.split('?')[0] : '';
    var v = Number(range.value), manual = false; // tint position, 0 (G3) to 5 (G70); fractional while the stage scrubs
    function src(s) { return '/media/porsche/frames/' + view.dataset.view + '/' + s.g.toLowerCase() + '.webp'; }
    function update() {
      var i = Math.min(4, Math.floor(v)), f = Math.min(1, v - i), s = shades[Math.round(v)];
      out.textContent = s.g;
      if (pct) pct.textContent = s.vlt + '%';
      desc.textContent = s.desc;
      range.setAttribute('aria-valuetext', s.g + ', ' + s.vlt + '% de luz passa');
      base.src = src(shades[i]); next.src = src(shades[i + 1]); next.style.opacity = f; // crossfade between adjacent frames
      if (cta) cta.href = ctaBase + '?text=' + encodeURIComponent('Olá! Simulei a tonalidade ' + s.g + ' no site e quero orientação para meu carro.');
    }
    range.addEventListener('input', function () { manual = true; v = Number(range.value); update(); });
    scene.addEventListener('stage:tint', function (e) {
      var q = e.detail;
      if (q < 0) { manual = false; return; } // scrolled back above the simulator: the demo may run again
      if (manual) return;
      v = 5 * (1 - q); range.value = Math.round(v); update();
    });
    update();
    function preload(b) { if (b.dataset.loaded) return; b.dataset.loaded = '1'; shades.forEach(function (s) { new Image().src = '/media/porsche/frames/' + b.dataset.view + '/' + s.g.toLowerCase() + '.webp'; }); }
    if (document.readyState === 'complete') preload(view); else addEventListener('load', function () { preload(view); });
    buttons.forEach(function (b) {
      b.addEventListener('click', function () { // changing the view keeps the tone
        preload(b);
        buttons.forEach(function (o) { o.classList.remove('is-active'); o.setAttribute('aria-pressed', 'false'); });
        b.classList.add('is-active'); b.setAttribute('aria-pressed', 'true');
        view = b; base.alt = b.dataset.alt; update();
      });
    });
  })();
</script>
