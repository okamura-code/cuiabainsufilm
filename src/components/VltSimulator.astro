---
/* Signature element: the one question every customer asks, answered live on real car photos.
   Rules from Res. CONTRAN 960/2022 as amended by 989/2022. Masks generated by scripts/masks.mjs. */
const views = [
  { id: 'lateral-esquerda', label: 'Lateral esquerda', alt: 'Porsche 911 branco visto pela lateral esquerda', frames: true },
  { id: 'lateral-direita', label: 'Lateral direita', alt: 'Porsche 911 branco visto pela lateral direita', frames: true },
  { id: 'frente', label: 'Frente', alt: 'Porsche 911 branco visto de frente', frames: true },
  { id: 'traseira', label: 'Traseira', alt: 'Porsche 911 branco visto por trás', frames: true },
];
---
<section class="section dark" id="lei">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Legislação</p>
      <h2>Quanto pode escurecer? Arraste e veja.</h2>
      <p class="muted">A lei fala em transmitância luminosa: quanto de luz atravessa o conjunto vidro + película. O número da tonalidade (G35, G20…) é exatamente isso. Escolha a vista, arraste e veja onde cada uma é permitida.</p>
    </div>
    <div class="vlt">
      <div class="vlt__stage">
        <div class="vlt__views" role="group" aria-label="Vista do carro">
          {views.map((v, i) => (
            <button type="button" class:list={['vlt__view', { 'is-active': i === 0 }]} data-view={v.id} data-alt={v.alt} data-frames={v.frames ? '1' : undefined} aria-pressed={i === 0 ? 'true' : 'false'}>{v.label}</button>
          ))}
        </div>
        <div class="vlt__photo" style="--tint:0.65">
          <img class="vlt__base" id="vlt-base" src={`media/porsche/frames/${views[0].id}/g35.webp`} alt={views[0].alt} width="1500" height="750" decoding="async" />
          <img class="vlt__maskimg" id="vlt-mask" src={`media/porsche/${views[0].id}-mask.png`} alt="" width="1600" height="900" loading="lazy" decoding="async" hidden />
        </div>
        <p class="vlt__caption">Vidros simulados sobre fotos de divulgação. O resultado real depende do vidro de fábrica.</p>
      </div>
      <div class="vlt__panel">
        <div class="vlt__readout"><output for="vlt-range" id="vlt-out">G35</output><small id="vlt-pct">35% DE LUZ PASSA</small></div>
        <label for="vlt-range" class="sr-only">Tonalidade da película</label>
        <input type="range" id="vlt-range" min="0" max="5" step="1" value="3" aria-valuetext="G35, 35% de luz passa" />
        <div class="vlt__ticks" aria-hidden="true"><span>G3</span><span>G5</span><span>G20</span><span>G35</span><span>G50</span><span>G70</span></div>
        <p class="vlt__desc" id="vlt-desc"></p>
        <ul class="vlt__rules">
          <li id="rule-front" data-state="no">
            <div><strong>Para-brisa e vidros dianteiros</strong><span>Mínimo de 70% de transmitância.</span></div>
            <span class="vlt__state">Não permitido</span>
          </li>
          <li id="rule-rear" data-state="ok">
            <div><strong>Vidros traseiros e vigia</strong><span>Sem mínimo, com retrovisores externos dos dois lados.</span></div>
            <span class="vlt__state">Permitido</span>
          </li>
        </ul>
        <p class="vlt__note">Película espelhada é proibida em qualquer vidro. Na fiscalização, o medidor soma 7% ao valor lido. Fonte: Resolução CONTRAN 960/2022, alterada pela 989/2022.</p>
      </div>
    </div>
  </div>
</section>
<script is:inline>
  (function () {
    var shades = [
      { g: 'G3', vlt: 3, desc: 'Privacidade extrema, quase opaca. Só para vidros traseiros.' },
      { g: 'G5', vlt: 5, desc: 'Uma das mais escuras do mercado. Máxima privacidade e forte redução de luminosidade.' },
      { g: 'G20', vlt: 20, desc: 'Intermediária: discrição com visibilidade razoável.' },
      { g: 'G35', vlt: 35, desc: 'Mais clara. Conforto térmico sem comprometer a visão à noite.' },
      { g: 'G50', vlt: 50, desc: 'Leve escurecimento, boa visibilidade.' },
      { g: 'G70', vlt: 70, desc: 'Quase transparente. É a usada no para-brisa e nos dianteiros para cumprir a lei.' },
    ];
    var range = document.getElementById('vlt-range');
    var out = document.getElementById('vlt-out');
    var pct = document.getElementById('vlt-pct');
    var desc = document.getElementById('vlt-desc');
    var photo = document.querySelector('.vlt__photo');
    var base = document.getElementById('vlt-base');
    var mask = document.getElementById('vlt-mask');
    var front = document.getElementById('rule-front');
    var buttons = document.querySelectorAll('.vlt__view');
    if (!range || !out || !photo || !base || !mask || !front) return;
    var view = document.querySelector('.vlt__view.is-active');
    // Views with per-tonality frames (data-frames) swap the whole photo; the others darken the glass through the mask.
    function hasFrames() { return !!view.dataset.frames; }
    function frameSrc(s) { return 'media/porsche/frames/' + view.dataset.view + '/' + s.g.toLowerCase() + '.webp'; }
    function update() {
      var s = shades[Number(range.value)];
      out.textContent = s.g;
      pct.textContent = s.vlt + '% DE LUZ PASSA';
      desc.textContent = s.desc;
      range.setAttribute('aria-valuetext', s.g + ', ' + s.vlt + '% de luz passa');
      photo.style.setProperty('--tint', String((100 - s.vlt) / 100));
      if (hasFrames()) { base.src = frameSrc(s); mask.hidden = true; }
      else { mask.hidden = false; }
      var ok = s.vlt >= 70;
      front.dataset.state = ok ? 'ok' : 'no';
      front.querySelector('.vlt__state').textContent = ok ? 'Permitido' : 'Não permitido';
    }
    range.addEventListener('input', update);
    update();
    buttons.forEach(function (b) {
      // preload so switching is instant
      if (b.dataset.frames) { shades.forEach(function (s) { new Image().src = 'media/porsche/frames/' + b.dataset.view + '/' + s.g.toLowerCase() + '.webp'; }); }
      else { new Image().src = 'media/porsche/' + b.dataset.view + '.jpg'; new Image().src = 'media/porsche/' + b.dataset.view + '-mask.png'; }
      b.addEventListener('click', function () {
        buttons.forEach(function (o) { o.classList.remove('is-active'); o.setAttribute('aria-pressed', 'false'); });
        b.classList.add('is-active');
        b.setAttribute('aria-pressed', 'true');
        view = b;
        base.alt = b.dataset.alt;
        if (!hasFrames()) { base.src = 'media/porsche/' + b.dataset.view + '.jpg'; mask.src = 'media/porsche/' + b.dataset.view + '-mask.png'; }
        update();
      });
    });
  })();
</script>
