---
/* Signature element: the one question every customer asks, answered live on real car photos.
   Rules from Res. CONTRAN 960/2022 as amended by 989/2022. Frames generated per tonality (scripts/frames.mjs).
   v3: scene shell (SceneHead, mono labels, VLT readout).
   v3.1 "moviescroller": on desktop (≥900px, ≥640px tall, no reduced motion) the section is 400vh with a sticky stage;
   scroll progress scrubs the tint G70→G3 by crossfading adjacent frames. The range input still works everywhere. */
import Icons from './Icons.astro';
import SceneHead from './SceneHead.astro';
import { wa } from '../data/site';
const views = [
  { id: 'frente', label: 'Frente', alt: 'Porsche 911 branco visto de frente' },
  { id: 'lateral-esquerda', label: 'Lateral esq.', alt: 'Porsche 911 branco visto pela lateral esquerda' },
  { id: 'lateral-direita', label: 'Lateral dir.', alt: 'Porsche 911 branco visto pela lateral direita' },
  { id: 'traseira', label: 'Traseira', alt: 'Porsche 911 branco visto por trás' },
];
---
<section class="section dark vlt-scene" id="simulador">
  <div class="vlt-scene__pin">
  <div class="wrap">
    <div class="vlt">
      <div class="vlt__stage">
        <SceneHead idx="03" eyebrow="Simulador de tonalidade">
          Escolha o tom<span class="dot">.</span> Veja antes de aplicar<span class="dot">.</span>
          <Fragment slot="lead">Seis tonalidades Window Blue, quatro ângulos. O carro é ilustrativo; a lógica da lei vale para o seu.</Fragment>
        </SceneHead>
        <div class="vlt__views" role="group" aria-label="Vista do carro">
          {views.map((v, i) => (
            <button type="button" class:list={['vlt__view', { 'is-active': i === 0 }]} data-view={v.id} data-alt={v.alt} aria-pressed={i === 0 ? 'true' : 'false'}>{v.label}</button>
          ))}
        </div>
        <div class="vlt__photo">
          <img class="vlt__base" id="vlt-base" src={`/media/porsche/frames/${views[0].id}/g35.webp`} alt={views[0].alt} width="1500" height="750" decoding="async" />
          <img class="vlt__next" id="vlt-next" src={`/media/porsche/frames/${views[0].id}/g50.webp`} alt="" width="1500" height="750" decoding="async" loading="lazy" aria-hidden="true" />
        </div>
        <p class="vlt__caption mono">Simulação visual · a aparência real varia com o vidro e a luz<span class="vlt__hint"> · Role para escurecer ↓</span></p>
      </div>
      <div class="vlt__panel">
        <div class="vlt__readout"><output for="vlt-range" id="vlt-out">G35</output><small>Tonalidade</small></div>
        <p class="vlt__vlt">Luz que passa: <b id="vlt-pct">35%</b></p>
        <label for="vlt-range" class="sr-only">Tonalidade da película</label>
        <input type="range" id="vlt-range" min="0" max="5" step="1" value="3" aria-valuetext="G35, 35% de luz passa" />
        <div class="vlt__ticks" aria-hidden="true"><span>G3</span><span>G5</span><span>G20</span><span>G35</span><span>G50</span><span>G70</span></div>
        <p class="vlt__desc" id="vlt-desc"></p>
        <div class="vlt__info">
          <Icons name="info" class="vlt__info-icon" />
          <div><strong>Antes de escolher</strong><p id="vlt-legal"></p></div>
        </div>
        <a class="btn btn--block" id="vlt-cta" href={wa('Olá! Quero orientação sobre a tonalidade ideal para meu carro.')} target="_blank" rel="noopener"><Icons name="wa" /> Orientação pelo WhatsApp</a>
      </div>
    </div>
  </div>
  </div>
</section>
<script is:inline data-astro-rerun>
  (function () {
    var shades = [
      { g: 'G3', vlt: 3, desc: 'Privacidade extrema, quase opaca.' },
      { g: 'G5', vlt: 5, desc: 'Uma das mais escuras do mercado. Máxima privacidade.' },
      { g: 'G20', vlt: 20, desc: 'Discrição com visibilidade razoável.' },
      { g: 'G35', vlt: 35, desc: 'Equilíbrio entre privacidade e visibilidade.' },
      { g: 'G50', vlt: 50, desc: 'Leve escurecimento, boa visibilidade.' },
      { g: 'G70', vlt: 70, desc: 'Quase transparente. A usada no para-brisa e nos dianteiros.' },
    ];
    var range = document.getElementById('vlt-range');
    var out = document.getElementById('vlt-out');
    var pct = document.getElementById('vlt-pct');
    var desc = document.getElementById('vlt-desc');
    var legal = document.getElementById('vlt-legal');
    var base = document.getElementById('vlt-base');
    var next = document.getElementById('vlt-next');
    var cta = document.getElementById('vlt-cta');
    var scene = document.getElementById('simulador');
    var buttons = document.querySelectorAll('.vlt__view');
    var view = document.querySelector('.vlt__view.is-active');
    if (!range || !out || !base || !next || !view) return;
    var ctaBase = cta ? cta.href.split('?')[0] : '';
    var v = Number(range.value); // tint position, 0 (G3) to 5 (G70); fractional while scroll-scrubbing
    function src(s) { return '/media/porsche/frames/' + view.dataset.view + '/' + s.g.toLowerCase() + '.webp'; }
    function update() {
      var i = Math.min(4, Math.floor(v)), f = Math.min(1, v - i);
      var s = shades[Math.round(v)];
      out.textContent = s.g;
      if (pct) pct.textContent = s.vlt + '%';
      desc.textContent = s.desc;
      legal.textContent = s.vlt >= 70
        ? 'Permitida em todos os vidros, inclusive para-brisa e dianteiros. Resolução CONTRAN 960/2022.'
        : 'Permitida nos vidros traseiros e vigia. Para-brisa e dianteiros exigem mínimo de 70% de luz (G70). Resolução CONTRAN 960/2022.';
      range.setAttribute('aria-valuetext', s.g + ', ' + s.vlt + '% de luz passa');
      // crossfade: lower frame underneath, upper frame fades in with the fractional part
      base.src = src(shades[i]);
      next.src = src(shades[i + 1]);
      next.style.opacity = f;
      if (cta) cta.href = ctaBase + '?text=' + encodeURIComponent('Olá! Simulei a tonalidade ' + s.g + ' no site e quero orientação para meu carro.');
    }
    range.addEventListener('input', function () { v = Number(range.value); update(); });
    update();
    // moviescroller (same media query as the CSS pin): section progress 0→1 maps to G70→G3
    var pin = matchMedia('(min-width: 900px) and (min-height: 640px) and (prefers-reduced-motion: no-preference)');
    if (scene && pin.matches) {
      var ticking = false;
      var onScroll = function () {
        if (ticking || !scene.isConnected || !pin.matches) return;
        ticking = true;
        requestAnimationFrame(function () {
          ticking = false;
          var top = scene.getBoundingClientRect().top;
          var span = scene.offsetHeight - window.innerHeight + 68; // sticky runs from top=68 (header) to bottom=viewport
          if (span <= 0) return;
          var p = Math.min(1, Math.max(0, (68 - top) / span));
          v = 5 * (1 - p);
          range.value = Math.round(v);
          update();
        });
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
    function preload(v) { if (v.dataset.loaded) return; v.dataset.loaded = '1'; shades.forEach(function (s) { new Image().src = '/media/porsche/frames/' + v.dataset.view + '/' + s.g.toLowerCase() + '.webp'; }); }
    if (document.readyState === 'complete') preload(view); else addEventListener('load', function () { preload(view); }); // after fonts/hero: only the active view
    buttons.forEach(function (b) {
      b.addEventListener('click', function () {
        preload(b);
        buttons.forEach(function (o) { o.classList.remove('is-active'); o.setAttribute('aria-pressed', 'false'); });
        b.classList.add('is-active');
        b.setAttribute('aria-pressed', 'true');
        view = b;
        base.alt = b.dataset.alt;
        update();
      });
    });
  })();
</script>
