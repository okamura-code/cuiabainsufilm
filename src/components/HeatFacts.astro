---
/* "Raio-X do vidro" em 3 atos: o sol entra, a película entra, o calor fica fora.
   Desktop (trava padrão): seção 300vh com palco sticky; o progresso p (0→1) escolhe o ato (data-act), que o CSS traduz em
   "termografia" sobre a foto real (véu de calor, película descendo, barra de calor). Mobile: sem trava, p vem da posição do palco.
   Reduced-motion ou sem JS: estado final (frio) e os 3 parágrafos visíveis.
   Counters: final value is in the HTML; Base.astro only animates the digits. Nothing with verified:false renders. */
import SceneHead from './SceneHead.astro';
import { counters, wa } from '../data/site';
import Icons from './Icons.astro';
const facts = counters.filter((c) => c.verified);
const fmt = (v: number, d: number) => v.toLocaleString('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d });
const acts = ['O sol entra inteiro. O banco vira chapa.', 'A película entra entre o vidro e você.', 'O calor fica do lado de fora. A luz, não.'];
---
<section class="section heat xray-scene" id="calor">
  <div class="xray__pin">
  <div class="wrap xray">
    <div class="xray__copy">
      <SceneHead idx="02" eyebrow="Raio-X do vidro">
        O vidro é a porta<span class="dot">.</span> A película é a chave<span class="dot">.</span>
        <Fragment slot="lead">Em Cuiabá o sol chega antes do trânsito. Bate no vidro, entra no banco, fica no volante. A gente não muda o clima. Muda o que ele consegue fazer com o seu carro.</Fragment>
      </SceneHead>
      <div class="xray__text">
        {acts.map((t, i) => <p class="xray__line" data-act={i}><span class="mono">0{i + 1}</span>{t}</p>)}
      </div>
      <p class="heat__src">Números da própria loja e da Resolução CONTRAN 960/2022. Percentuais de rejeição de calor e UV dependem da linha Window Blue escolhida: pedimos a ficha técnica no orçamento.</p>
      <div class="actions">
        <a class="btn" href={wa('Olá! Quero saber qual película Window Blue segura mais calor para meu carro.')} target="_blank" rel="noopener"><Icons name="wa" /> Qual película segura mais calor?</a>
      </div>
    </div>
    <div class="xray__side">
      <figure class="xray__stage">
        <img class="xray__photo" src="/media/gal-suv-oficina.webp" srcset="/media/gal-suv-oficina-640.webp 640w, /media/gal-suv-oficina.webp 1200w" sizes="(min-width: 900px) 50vw, 100vw" alt="SUV cinza na oficina da Cuiabá Insulfilm, para-brisa e vidros com película" width="1200" height="1600" loading="lazy" decoding="async" />
        <div class="xray__heat" aria-hidden="true"></div>
        <div class="xray__film" aria-hidden="true"></div>
        <figcaption class="xray__meter mono"><span>Calor dentro do carro</span><i><b></b></i></figcaption>
      </figure>
      <ul class="heat__facts">
        {facts.map((c) => (
          <li>
            <span class="heat__num"><span data-count={c.value} data-decimals={c.decimals}>{fmt(c.value, c.decimals)}</span>{c.sup && <sup>{c.sup}</sup>}</span>
            <strong>{c.label}</strong>
            <small>{c.note}</small>
          </li>
        ))}
      </ul>
    </div>
  </div>
  </div>
</section>
<script is:inline data-astro-rerun>
  (function () {
    var sec = document.getElementById('calor');
    if (sec) sec.dataset.xr = ''; // JS ran: scenes.css may pin (no-JS keeps the static layout)
    var stage = sec && sec.querySelector('.xray__stage');
    if (!sec || !stage) return;
    var pin = matchMedia('(min-width: 900px) and (min-height: 640px) and (prefers-reduced-motion: no-preference)');
    var mob = matchMedia('(max-width: 899px) and (prefers-reduced-motion: no-preference)');
    var ticking = false;
    function update() {
      ticking = false;
      var p;
      if (pin.matches) {
        var span = sec.offsetHeight - innerHeight + 68; // sticky runs from top=68 (header) to bottom=viewport
        if (span <= 0) return;
        p = (68 - sec.getBoundingClientRect().top) / span;
      } else if (mob.matches) {
        p = 1 - stage.getBoundingClientRect().top / innerHeight; // not pinned: acts play while the stage crosses the screen
      } else { delete sec.dataset.act; return; }
      p = Math.min(1, Math.max(0, p));
      sec.dataset.act = p < 0.33 ? '0' : p < 0.66 ? '1' : '2';
    }
    function onScroll() {
      if (!sec.isConnected) { removeEventListener('scroll', onScroll); removeEventListener('resize', onScroll); return; }
      if (ticking) return; ticking = true; requestAnimationFrame(update);
    }
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    update();
  })();
</script>
