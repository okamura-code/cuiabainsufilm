---
/* "O vidro é a porta de entrada do calor": verified counters + a qualitative glass diagram.
   Counters: final value is in the HTML; Base.astro only animates the digits. Nothing with verified:false renders. */
import SceneHead from './SceneHead.astro';
import { counters, wa } from '../data/site';
import Icons from './Icons.astro';
const facts = counters.filter((c) => c.verified);
const fmt = (v: number, d: number) => v.toLocaleString('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d });
---
<section class="section heat" id="calor">
  <div class="wrap heat__grid">
    <div>
      <SceneHead idx="02" eyebrow="Onde o calor entra">
        O vidro é a porta<span class="dot">.</span> A película é a chave<span class="dot">.</span>
        <Fragment slot="lead">Em Cuiabá o sol chega antes do trânsito. Bate no vidro, entra no banco, fica no volante. A gente não muda o clima. Muda o que ele consegue fazer com o seu carro.</Fragment>
      </SceneHead>
      <ul class="heat__facts">
        {facts.map((c) => (
          <li>
            <span class="heat__num"><span data-count={c.value} data-decimals={c.decimals}>{fmt(c.value, c.decimals)}</span>{c.sup && <sup>{c.sup}</sup>}</span>
            <strong>{c.label}</strong>
            <small>{c.note}</small>
          </li>
        ))}
      </ul>
      <p class="heat__src">Números da própria loja e da Resolução CONTRAN 960/2022. Percentuais de rejeição de calor e UV dependem da linha Window Blue escolhida: pedimos a ficha técnica no orçamento.</p>
      <div class="actions">
        <a class="btn" href={wa('Olá! Quero saber qual película Window Blue segura mais calor para meu carro.')} target="_blank" rel="noopener"><Icons name="wa" /> Qual película segura mais calor?</a>
      </div>
    </div>
    <figure class="glass" aria-labelledby="glass-cap">
      <svg viewBox="0 0 640 420" role="img" aria-labelledby="glass-title">
        <title id="glass-title">Diagrama: sol à esquerda, vidro com película ao centro, interior do carro à direita. Calor e raios UV são refletidos pela película; a luz visível passa na medida escolhida.</title>
        <defs>
          <linearGradient id="g-film" x1="0" x2="1"><stop offset="0" stop-color="#a4e52e" stop-opacity=".9" /><stop offset="1" stop-color="#a4e52e" stop-opacity=".3" /></linearGradient>
          <radialGradient id="g-sun"><stop offset="0" stop-color="#ffb347" /><stop offset="1" stop-color="#ff7a2a" stop-opacity="0" /></radialGradient>
        </defs>
        <g font-family="ui-monospace, Menlo, monospace" font-size="11" letter-spacing="1.5" fill="#b4aea2">
          <text x="24" y="30">LADO DE FORA</text>
          <text x="616" y="30" text-anchor="end">LADO DE DENTRO</text>
          <text x="320" y="404" text-anchor="middle">VIDRO + PELÍCULA WINDOW BLUE</text>
        </g>
        <!-- sun -->
        <circle cx="110" cy="130" r="92" fill="url(#g-sun)" opacity=".55" />
        <circle cx="110" cy="130" r="34" fill="#ffb347" />
        <!-- glass + film -->
        <rect x="312" y="56" width="14" height="326" rx="2" fill="#ece8df" fill-opacity=".10" stroke="#ece8df" stroke-opacity=".25" />
        <rect x="326" y="56" width="6" height="326" rx="1" fill="url(#g-film)" />
        <!-- cabin -->
        <path d="M372 300h210q20 0 20-20v-120q0-20-20-20h-130l-60 46v94q0 20-20 20z" fill="#ece8df" fill-opacity=".05" stroke="#ece8df" stroke-opacity=".18" />
        <!-- rays: heat (reflected), UV (reflected), visible light (passes, attenuated) -->
        <g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path class="draw" d="M150 108 L306 150 L190 60" stroke="#ff7a2a" />
          <path class="draw" d="M150 150 L306 214 L200 330" stroke="#c77da0" />
          <path class="draw" d="M150 190 L306 262 L332 262 L500 262" stroke="#ece8df" stroke-opacity=".9" />
          <path class="draw" d="M332 262 L500 262" stroke="#ece8df" stroke-opacity=".35" stroke-dasharray="6 8" />
        </g>
        <g font-family="ui-monospace, Menlo, monospace" font-size="11" letter-spacing="1.5">
          <text x="214" y="52" fill="#ff7a2a">CALOR · REFLETIDO</text>
          <text x="210" y="352" fill="#c77da0">UV · BLOQUEADO</text>
          <text x="500" y="250" fill="#ece8df" text-anchor="end">LUZ · NA MEDIDA (G3–G70)</text>
        </g>
      </svg>
      <figcaption id="glass-cap" class="mono" style="margin-top:.9rem">Esquema ilustrativo. A quantidade exata varia com a tonalidade e a linha da película.</figcaption>
      <ul class="glass__legend" aria-hidden="true">
        <li><i style="background:#ff7a2a"></i>Calor</li>
        <li><i style="background:#c77da0"></i>Raios UV</li>
        <li><i style="background:#ece8df"></i>Luz visível</li>
        <li><i style="background:#a4e52e"></i>Película</li>
      </ul>
    </figure>
  </div>
</section>
